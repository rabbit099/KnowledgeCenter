# Copy to .env and fill in. Every variable the application reads is listed here.
# Secrets belong only in .env (chmod 600) or Docker secrets, never in the repository.

# --- General ---
# Display name shown in the UI. Never hard-coded in code or templates.
APP_NAME="Baza Wiedzy"
# Image tag to run in production, for example 1.0.0.
APP_VERSION=0.0.0
# Log level: DEBUG, INFO, WARNING, ERROR. Logs are JSON lines on stdout/stderr.
LOG_LEVEL=INFO
# Comma-separated list of optional modules to enable. The core is always enabled.
# Available: documents, ingestion, search. Dependencies are checked at startup
# (ingestion and search require documents).
ENABLED_MODULES=documents,ingestion,search
# DNS name used by the proxy (Caddy).
PUBLIC_HOSTNAME=localhost
# internal | files | acme
TLS_MODE=internal
# Signing key for sessions and CSRF. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Contact e-mail for Let's Encrypt (TLS_MODE=acme only).
ACME_EMAIL=
# Largest HTTP request body accepted by the proxy, in MB (must be above MAX_UPLOAD_MB).
MAX_REQUEST_MB=110

# Host ports published by the proxy (inside the container Caddy listens on 8080/8443).
HTTP_PORT=80
HTTPS_PORT=443

# --- Images ---
# Registry and name prefix of the images (GHCR, private; ADR-017).
# The final names are <prefix>-app, <prefix>-worker, <prefix>-db, <prefix>-proxy with tag APP_VERSION.
IMAGE_PREFIX=ghcr.io/change-me/baza-wiedzy

# --- Database ---
# Password of the PostgreSQL superuser "postgres". Used only by the db container itself
# (first start, maintenance); the application never connects with it.
POSTGRES_PASSWORD=change-me
# Non-superuser that owns the application database. Created on the first start of an empty
# database volume; the application and migrations connect as this user.
APP_DB_USER=baza_wiedzy
APP_DB_PASSWORD=change-me
APP_DB_NAME=baza_wiedzy
# Explicit connection limit. Every connection loads the Polish dictionary (~27-30 MB).
# Budget: app 2 processes x (5 + 5 overflow) + worker processes x 1 + migrations/backup/admin.
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=256MB

# --- Redis (job queue) ---
# Password required by Redis (requirepass). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use only URL-safe characters (the command above does): it is embedded in REDIS_URL.
REDIS_PASSWORD=change-me

# --- Worker ---
# Number of worker processes (each: 1 thread, 1 database connection). OCR is CPU-heavy;
# do not exceed the number of CPU cores. Count them in POSTGRES_MAX_CONNECTIONS.
WORKER_PROCESSES=2

# --- Memory limits (Docker) ---
# DB_MEMORY_LIMIT >= POSTGRES_SHARED_BUFFERS + POSTGRES_MAX_CONNECTIONS x 35 MB + 300 MB headroom.
DB_MEMORY_LIMIT=2g
APP_MEMORY_LIMIT=1g
# OCR and LibreOffice run in the worker; large scans need memory.
WORKER_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=256m
# Only with the optional "antivirus" profile (docker compose --profile antivirus up -d).
CLAMAV_MEMORY_LIMIT=3g
