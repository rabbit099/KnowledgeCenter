# Copy to .env and fill in. Every variable the application reads is listed here.
# Secrets belong only in .env (chmod 600) or Docker secrets, never in the repository.

# --- General ---
# Display name shown in the UI. Never hard-coded in code or templates.
APP_NAME="Baza Wiedzy"
# Image tag to run in production, for example 1.0.0.
APP_VERSION=0.0.0
# Comma-separated list of optional modules to enable. The core is always enabled.
# Available: documents, ingestion, search. Dependencies are checked at startup
# (ingestion and search require documents).
ENABLED_MODULES=documents,ingestion,search
# DNS name used by the proxy (Caddy).
PUBLIC_HOSTNAME=localhost
# internal | files | acme
TLS_MODE=internal
# Signing key for sessions and CSRF. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
