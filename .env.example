# Copy to .env and fill in. Every variable the application reads is listed here.
# Secrets belong only in .env (chmod 600) or Docker secrets, never in the repository.

# --- General ---
# Display name shown in the UI. Never hard-coded in code or templates.
APP_NAME="Baza Wiedzy"
# Tag of the project images to run (docker-compose.yml): <IMAGE_PREFIX>-*:<APP_VERSION>.
# Required by Compose. It only selects the images; the application reports its own version
# from the installed package (pyproject.toml), visible on /health, /ready and in the footer.
APP_VERSION=0.1.0
# Log level: DEBUG, INFO, WARNING, ERROR. Logs are JSON lines on stdout/stderr.
LOG_LEVEL=INFO
# Comma-separated list of optional modules to enable. The core is always enabled.
# Available: documents, ingestion, search. Dependencies are checked at startup
# (ingestion and search require documents).
ENABLED_MODULES=documents,ingestion,search
# DNS name used by the proxy (Caddy).
PUBLIC_HOSTNAME=localhost
# internal | files | acme
TLS_MODE=internal
# Signing key for CSRF tokens. At least 32 characters; the application refuses to start with a
# weak value (such as this placeholder). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Contact e-mail for Let's Encrypt (TLS_MODE=acme only).
ACME_EMAIL=
# Largest HTTP request body accepted by the proxy, in MB (must be above MAX_UPLOAD_MB).
MAX_REQUEST_MB=110

# Docker network of the stack (fixed, so that the proxy has a fixed address the application
# trusts for X-Forwarded-For). Change both if 172.30.70.0/24 collides with a company network or
# a VPN route: PROXY_IP must lie inside DOCKER_SUBNET.
DOCKER_SUBNET=172.30.70.0/24
PROXY_IP=172.30.70.10

# --- Sessions and login limits ---
# A session ends after SESSION_IDLE_MINUTES without requests or SESSION_ABSOLUTE_HOURS after login.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Failed logins counted in a window of LOGIN_WINDOW_MINUTES; reaching a threshold locks for
# LOGIN_LOCKOUT_MINUTES (locks expire by themselves; `baza-wiedzy unlock-login` clears them).
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_FAILURES_ACCOUNT=30
LOGIN_MAX_FAILURES_ACCOUNT_IP=5
LOGIN_MAX_FAILURES_IP=20

# Host ports published by the proxy (inside the container Caddy listens on 8080/8443).
HTTP_PORT=80
HTTPS_PORT=443

# --- Images ---
# Registry and name prefix of the images (GHCR, private; ADR-017).
# The final names are <prefix>-app, <prefix>-worker, <prefix>-db, <prefix>-proxy with tag APP_VERSION.
IMAGE_PREFIX=ghcr.io/change-me/baza-wiedzy

# --- Database ---
# Password of the PostgreSQL superuser "postgres". Used only by the db container itself
# (first start, maintenance); the application never connects with it.
POSTGRES_PASSWORD=change-me
# Non-superuser that owns the application database. Created on the first start of an empty
# database volume; the application and migrations connect as this user.
APP_DB_USER=baza_wiedzy
APP_DB_PASSWORD=change-me
APP_DB_NAME=baza_wiedzy
# Explicit connection limit. Every connection loads the Polish dictionary (~27-30 MB).
# Budget: app 2 processes x (5 + 5 overflow) + worker processes x 1 + migrations/backup/admin.
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=256MB

# --- Redis (job queue) ---
# Password required by Redis (requirepass). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use only URL-safe characters (the command above does): it is embedded in REDIS_URL.
REDIS_PASSWORD=change-me

# --- Advanced (defaults are fine; listed so that every variable the application reads is here) ---
# DATABASE_URL and REDIS_URL are built in docker-compose.yml from the passwords above.
# Database pool per app process (the worker always uses 1 + 0, set in docker-compose.yml).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Seconds between worker heartbeats; /ready reports "no heartbeat" after 4 missed ones.
# WORKER_HEARTBEAT_SECONDS=15
# Session cookie with the Secure flag (and the __Host- prefix). Keep true: the proxy always
# serves HTTPS. false only for experiments without TLS.
# SESSION_COOKIE_SECURE=true
# Alembic configuration file inside the images.
# ALEMBIC_INI=alembic.ini

# --- Local break-glass admin (baza-wiedzy create-admin) ---
# Password length limits (characters) and how many Argon2id hashes (64 MiB each) may run at the
# same time per process.
LOCAL_PASSWORD_MIN_LENGTH=14
LOCAL_PASSWORD_MAX_LENGTH=256
ARGON2_MAX_CONCURRENT=3

# --- Worker ---
# Number of worker processes (each: 1 thread, 1 database connection). OCR is CPU-heavy;
# do not exceed the number of CPU cores. Count them in POSTGRES_MAX_CONNECTIONS.
WORKER_PROCESSES=2

# --- Memory limits (Docker) ---
# DB_MEMORY_LIMIT >= POSTGRES_SHARED_BUFFERS + POSTGRES_MAX_CONNECTIONS x 35 MB + 300 MB headroom.
DB_MEMORY_LIMIT=2g
APP_MEMORY_LIMIT=1g
# OCR and LibreOffice run in the worker; large scans need memory.
WORKER_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=256m
# Only with the optional "antivirus" profile (docker compose --profile antivirus up -d).
CLAMAV_MEMORY_LIMIT=3g
