# Reverse proxy and TLS. TLS_MODE (from .env) selects one of the snippets below:
#   internal - certificate from Caddy's own internal CA (development, closed networks)
#   files    - certificate and key provided in ./secrets/tls/ (company CA)
#   acme     - Let's Encrypt (needs a public DNS name and port 80/443 reachable from the internet)
{
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	skip_install_trust
	admin off
	# Caddy's own log (errors such as "upstream unreachable" quote the request): same filter
	# as the access log below, no search phrases (ADR-025).
	log default {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.*$ "?[removed]"
			request>headers>Referer delete
			request>headers>Hx-Current-Url delete
		}
	}
}

(tls-internal) {
	tls internal
}

(tls-files) {
	tls /certs/cert.pem /certs/key.pem
}

(tls-acme) {
	tls {$ACME_EMAIL}
}

http://{$PUBLIC_HOSTNAME} {
	redir https://{host}{uri} permanent
}

https://{$PUBLIC_HOSTNAME} {
	import tls-{$TLS_MODE}
	encode zstd gzip
	request_body {
		max_size {$MAX_REQUEST_MB:501}MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy app:8000
	# A request body above MAX_REQUEST_MB is cut off here (413). The application refuses forms
	# above UPLOAD_MAX_TOTAL_MB itself with a message in the form; this page covers the rest
	# (browser without JavaScript, MAX_REQUEST_MB lowered), instead of an empty error response.
	handle_errors 413 {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="pl"><head><meta charset="utf-8"><title>Za duże żądanie</title></head>
			<body><h1>Za duże żądanie</h1>
			<p>Wysłane pliki są razem większe niż dozwolony rozmiar ({$MAX_REQUEST_MB:501} MB). Wgraj je w kilku częściach.</p>
			<p><a href="/documents/upload">Wróć do wgrywania</a></p></body></html>
			HTML 413
	}
	# Access log without search phrases, file names and tokens (ADR-025): query strings, the
	# Referer and HX-Current-URL request headers (full URL of the previous page), redirect
	# targets (a login redirect carries the requested URL), Content-Disposition (the name of a
	# downloaded file) and the X-CSRF-Token header are removed. Caddy itself redacts Cookie,
	# Set-Cookie and Authorization.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.*$ "?[removed]"
			request>headers>Referer delete
			request>headers>Hx-Current-Url delete
			request>headers>X-Csrf-Token delete
			resp_headers>Location delete
			resp_headers>Hx-Redirect delete
			resp_headers>Content-Disposition delete
		}
	}
}
